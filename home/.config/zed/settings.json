// Zed settings (portable backup)
//
// Intentionally excluded from the live ~/.config/zed/settings.json:
// - context_servers.mcp-server-github (contained a GitHub personal access token)
// - ssh_connections (machine-specific LAN hosts and remote project paths)
// - language_models.openai_compatible."LM Studio" (machine-specific LAN api_url)
{
  "auto_install_extensions": {
    "catppuccin-icons": true,
    "dockerfile": true,
    "html": true,
    "ktrz-monokai": true,
    "log": true,
    "mcp-server-github": true,
    "monokai-og": true,
    "monokai-pro-ce": true
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "tree_view": false,
    "dock": "left"
  },
  "diff_view_style": "split",
  "edit_predictions": {
    "provider": "zed"
  },
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Macchiato",
    "dark": "Catppuccin Macchiato"
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    },
    "opencode": {
      "default_config_options": {
        "model": "openai/gpt-5.5"
      },
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "format_on_save": "off",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark Pro"
  },
  "theme_overrides": {
    "One Dark Pro": {
      "syntax": {
        "tag.component.jsx": {
          "color": "#66d9ef"
        }
      }
    }
  },
  "semantic_tokens": "combined",
  "agent": {
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "single_file_review": true,
    "sidebar_side": "right",
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "skill": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^git\\b"
            }
          ]
        },
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://zed\\.dev"
            }
          ]
        }
      }
    },
    "play_sound_when_agent_done": "always",
    "default_profile": "write",
    "default_model": {
      "effort": "low",
      "enable_thinking": true,
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol"
    }
  },
  "base_keymap": "SublimeText",
  "ui_font_size": 14,
  "buffer_font_size": 12.0,
  "buffer_line_height": { "custom": 1.4 },
  "buffer_font_weight": 400,
  "hard_tabs": true,
  "tab_size": 2,
  "current_line_highlight": "none",
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": true
  },
  "project_panel": {
    "dock": "left",
    "entry_spacing": "standard"
  },
  "tabs": {
    "file_icons": true
  }
}
